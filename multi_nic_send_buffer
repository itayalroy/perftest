#!/bin/bash
#
# Wrapper script for multi-NIC RDMA send buffer test
# Runs as client (sender) with configurable NVLink support
#

# Hardcoded configuration
ALL_NICS="mlx5_0,mlx5_1,mlx5_2,mlx5_4,mlx5_5,mlx5_6,mlx5_7,mlx5_8"
ALL_GPUS="0,1,2,3,4,5,6,7"

# Parse arguments
USE_NVLINK=0
DIRECT_MODE=0
REASSEMBLY=0
ALL_TO_ALL=0
DEBUG=0
RECV_IP=""
SOURCE_GPUS=""
UTILIZE_NIC=""
TRANSPORT_BUFFER=""
TARGET_COUNT=""
DOUBLE_BUFFER=0

# First, check if receiver IP is provided as positional argument
if [[ $# -gt 0 ]] && [[ ! "$1" =~ ^-- ]]; then
    RECV_IP="$1"
    shift
fi

# Parse remaining arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        --allow-nvlink)
            USE_NVLINK=1
            shift
            ;;
        --direct)
            DIRECT_MODE=1
            shift
            ;;
        --reassembly)
            REASSEMBLY=1
            shift
            ;;
        --all-to-all)
            ALL_TO_ALL=1
            shift
            ;;
        --source-gpus)
            SOURCE_GPUS="$2"
            shift 2
            ;;
        --utilize-nic)
            UTILIZE_NIC="$2"
            shift 2
            ;;
        --transport-buffer)
            TRANSPORT_BUFFER="$2"
            shift 2
            ;;
        --target-count)
            TARGET_COUNT="$2"
            shift 2
            ;;
        --double-buffer)
            DOUBLE_BUFFER=1
            shift
            ;;
        --debug|-d)
            DEBUG=1
            shift
            ;;
        --help|-h)
            echo "Usage: $0 <RECEIVER_IP> [OPTIONS]"
            echo ""
            echo "Arguments:"
            echo "  RECEIVER_IP        IP address of the receiver (required)"
            echo ""
            echo "Options:"
            echo "  --allow-nvlink         Enable NVLink transfers (default: disabled, uses --nics-only)"
            echo "  --direct               Each GPU sends directly via its own NIC (no NVLink)"
            echo "  --reassembly           Enable reassembly on receiver (requires --allow-nvlink)"
            echo "  --all-to-all           Spread from each source to every target (N*M QPs); requires --direct or --allow-nvlink --reassembly and --source-gpus"
            echo "  --source-gpus <list>   Comma-separated GPU IDs to use (e.g., '0' or '0,3,5')"
            echo "                         Filters which GPUs to use"
            echo "  --utilize-nic <NIC>    Run extra QP on this NIC for background load (must be in -n list)"
            echo "  --transport-buffer <SIZE>  QP transport buffer size per GPU (e.g. 32M, 1G); enables piping. Not valid with --direct or --nics-only."
            echo "  --target-count <M>     Number of logical targets M (decouples M from NIC count K)."
            echo "                         Requires --allow-nvlink --reassembly --all-to-all. Not valid with --direct."
            echo "  --double-buffer        Allocate 2 transport buffers per QP; interleave NVLink fill with RDMA send."
            echo "                         Requires --transport-buffer. Not valid with --direct or --nics-only."
            echo "  --debug, -d            Print verbose output (iteration timing, pipe progress, etc.)"
            echo "  --help, -h             Show this help message"
            echo ""
            echo "Examples:"
            echo "  $0 10.52.48.100                           # Send with NICs-only mode (all from GPU 0)"
            echo "  $0 10.52.48.100 --allow-nvlink            # Send with NVLink enabled"
            echo "  $0 10.52.48.100 --direct                  # All GPUs send directly via their NICs"
            echo "  $0 10.52.48.100 --direct --source-gpus 0        # Only GPU 0 sends via mlx5_0"
            echo "  $0 10.52.48.100 --direct --source-gpus 0,3,5    # GPU 0,3,5 send via mlx5_0,mlx5_4,mlx5_6"
            echo "  $0 10.52.48.100 --direct --all-to-all --source-gpus 0,1  # All-to-all: GPU 0,1 send to all target NICs"
            echo "  $0 10.52.48.100 --allow-nvlink --reassembly --all-to-all --source-gpus 0,1 --target-count 4  # M=4 targets, K=8 NICs"
            exit 0
            ;;
        *)
            echo "Unknown option: $1"
            echo "Use --help for usage information"
            exit 1
            ;;
    esac
done

# Check if receiver IP is provided
if [[ -z "$RECV_IP" ]]; then
    echo "Error: Receiver IP address is required"
    echo "Usage: $0 <RECEIVER_IP> [OPTIONS]"
    echo "Use --help for more information"
    exit 1
fi

# Validate --all-to-all: requires --direct or (--allow-nvlink and --reassembly) and --source-gpus
if [[ $ALL_TO_ALL -eq 1 ]]; then
    if [[ $DIRECT_MODE -eq 0 ]] && [[ $USE_NVLINK -eq 0 || $REASSEMBLY -eq 0 ]]; then
        echo "Error: --all-to-all requires --direct or --allow-nvlink --reassembly"
        exit 1
    fi
    if [[ -z "$SOURCE_GPUS" ]]; then
        echo "Error: --all-to-all requires --source-gpus"
        exit 1
    fi
fi

# Validate --target-count: requires NVLink reassembly all-to-all, not valid with --direct
if [[ -n "$TARGET_COUNT" ]]; then
    if [[ $DIRECT_MODE -eq 1 ]]; then
        echo "Error: --target-count is not supported in direct mode"
        exit 1
    fi
    if [[ $ALL_TO_ALL -eq 0 || $REASSEMBLY -eq 0 || $USE_NVLINK -eq 0 ]]; then
        echo "Error: --target-count requires --allow-nvlink --reassembly --all-to-all"
        exit 1
    fi
fi

# Filter NICs and GPUs if source-gpus is specified AND in direct mode AND not all-to-all
# (all-to-all uses all NICs as targets and --source-gpus for sources; no filtering)
if [[ -n "$SOURCE_GPUS" ]] && [[ $DIRECT_MODE -eq 1 ]] && [[ $ALL_TO_ALL -eq 0 ]]; then
    # Direct mode: Filter to only use source GPU NICs
    IFS=',' read -ra ALL_NICS_ARRAY <<< "$ALL_NICS"
    IFS=',' read -ra ALL_GPUS_ARRAY <<< "$ALL_GPUS"
    IFS=',' read -ra SOURCE_GPUS_ARRAY <<< "$SOURCE_GPUS"
    
    FILTERED_NICS=()
    FILTERED_GPUS=()
    
    # For each source GPU, find its index and add corresponding NIC
    for src_gpu in "${SOURCE_GPUS_ARRAY[@]}"; do
        for i in "${!ALL_GPUS_ARRAY[@]}"; do
            if [[ "${ALL_GPUS_ARRAY[$i]}" == "$src_gpu" ]]; then
                FILTERED_GPUS+=("$src_gpu")
                FILTERED_NICS+=("${ALL_NICS_ARRAY[$i]}")
                break
            fi
        done
    done
    
    # Join arrays back to comma-separated strings
    NICS=$(IFS=,; echo "${FILTERED_NICS[*]}")
    GPUS=$(IFS=,; echo "${FILTERED_GPUS[*]}")
    
    if [[ -z "$NICS" ]] || [[ -z "$GPUS" ]]; then
        echo "Error: No valid GPUs found in --source-gpus"
        exit 1
    fi
else
    # NVLink or NICs-only mode: Use all NICs/GPUs
    NICS="$ALL_NICS"
    GPUS="$ALL_GPUS"
fi

# Build command
CMD="./test_rdma_multi_qp --nics ${NICS} --gpus ${GPUS} -a ${RECV_IP}"

# Add mode flags
if [[ $DIRECT_MODE -eq 1 ]]; then
    CMD="${CMD} --direct"
    if [[ $ALL_TO_ALL -eq 1 ]]; then
        CMD="${CMD} --all-to-all --source-gpus ${SOURCE_GPUS}"
    fi
elif [[ $USE_NVLINK -eq 0 ]]; then
    CMD="${CMD} --nics-only"
else
    # NVLink mode - pass source-gpus if specified
    if [[ -n "$SOURCE_GPUS" ]]; then
        CMD="${CMD} --source-gpus ${SOURCE_GPUS}"
    fi
    # Add reassembly flag if enabled
    if [[ $REASSEMBLY -eq 1 ]]; then
        CMD="${CMD} --reassembly"
    fi
    if [[ $ALL_TO_ALL -eq 1 ]]; then
        CMD="${CMD} --all-to-all"
    fi
fi
if [[ -n "$UTILIZE_NIC" ]]; then
    CMD="${CMD} --utilize-nic ${UTILIZE_NIC}"
fi
if [[ -n "$TRANSPORT_BUFFER" ]]; then
    CMD="${CMD} --transport-buffer ${TRANSPORT_BUFFER}"
fi
if [[ -n "$TARGET_COUNT" ]]; then
    CMD="${CMD} --target-count ${TARGET_COUNT}"
fi
if [[ $DEBUG -eq 1 ]]; then
    CMD="${CMD} --debug"
fi
if [[ $DOUBLE_BUFFER -eq 1 ]]; then
    CMD="${CMD} --double-buffer"
fi

# Execute
exec ${CMD}

