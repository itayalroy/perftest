#!/bin/bash
#
# Wrapper script for multi-NIC RDMA receive buffer test
# Runs as server (receiver) with configurable NVLink support
#

# Hardcoded configuration
ALL_NICS="mlx5_0,mlx5_1,mlx5_2,mlx5_4,mlx5_5,mlx5_6,mlx5_7,mlx5_8"
ALL_GPUS="0,1,2,3,4,5,6,7"

# Parse arguments
USE_NVLINK=0
DIRECT_MODE=0
SOURCE_GPUS=""

while [[ $# -gt 0 ]]; do
    case $1 in
        --allow-nvlink)
            USE_NVLINK=1
            shift
            ;;
        --direct)
            DIRECT_MODE=1
            shift
            ;;
        --source-gpus)
            SOURCE_GPUS="$2"
            shift 2
            ;;
        --help|-h)
            echo "Usage: $0 [OPTIONS]"
            echo ""
            echo "Options:"
            echo "  --allow-nvlink         Enable NVLink transfers (default: disabled, uses --nics-only)"
            echo "  --direct               Each GPU receives directly via its own NIC (no NVLink)"
            echo "  --source-gpus <list>   Comma-separated GPU IDs to use (e.g., '0' or '0,3,5')"
            echo "                         - In direct mode: filters which GPUs to use"
            echo "                         - In NVLink mode: multiple source GPUs (e.g., '0,1')"
            echo "  --help, -h             Show this help message"
            echo ""
            echo "Examples:"
            echo "  $0                                         # NICs-only mode (all to GPU 0)"
            echo "  $0 --allow-nvlink                          # NVLink mode (GPU 0 to all)"
            echo "  $0 --allow-nvlink --source-gpus 0,1        # Multi-source NVLink (GPU 0,1)"
            echo "  $0 --direct                                # All GPUs receive directly"
            echo "  $0 --direct --source-gpus 0                # Only GPU 0 receives via mlx5_0"
            echo "  $0 --direct --source-gpus 0,1,2            # GPU 0,1,2 via mlx5_0,3,4"
            exit 0
            ;;
        *)
            echo "Unknown option: $1"
            echo "Use --help for usage information"
            exit 1
            ;;
    esac
done

# Filter NICs and GPUs if source-gpus is specified AND in direct mode
if [[ -n "$SOURCE_GPUS" ]] && [[ $DIRECT_MODE -eq 1 ]]; then
    # Direct mode: Filter to only use source GPU NICs
    IFS=',' read -ra ALL_NICS_ARRAY <<< "$ALL_NICS"
    IFS=',' read -ra ALL_GPUS_ARRAY <<< "$ALL_GPUS"
    IFS=',' read -ra SOURCE_GPUS_ARRAY <<< "$SOURCE_GPUS"
    
    FILTERED_NICS=()
    FILTERED_GPUS=()
    
    # For each source GPU, find its index and add corresponding NIC
    for src_gpu in "${SOURCE_GPUS_ARRAY[@]}"; do
        for i in "${!ALL_GPUS_ARRAY[@]}"; do
            if [[ "${ALL_GPUS_ARRAY[$i]}" == "$src_gpu" ]]; then
                FILTERED_GPUS+=("$src_gpu")
                FILTERED_NICS+=("${ALL_NICS_ARRAY[$i]}")
                break
            fi
        done
    done
    
    # Join arrays back to comma-separated strings
    NICS=$(IFS=,; echo "${FILTERED_NICS[*]}")
    GPUS=$(IFS=,; echo "${FILTERED_GPUS[*]}")
    
    if [[ -z "$NICS" ]] || [[ -z "$GPUS" ]]; then
        echo "Error: No valid GPUs found in --source-gpus"
        exit 1
    fi
else
    # NVLink or NICs-only mode: Use all NICs/GPUs
    NICS="$ALL_NICS"
    GPUS="$ALL_GPUS"
fi

# Build command
CMD="./test_rdma_multi_qp -s --nics ${NICS} --gpus ${GPUS}"

# Add mode flags
if [[ $DIRECT_MODE -eq 1 ]]; then
    CMD="${CMD} --direct"
elif [[ $USE_NVLINK -eq 0 ]]; then
    CMD="${CMD} --nics-only"
else
    # NVLink mode - pass source-gpus if specified
    if [[ -n "$SOURCE_GPUS" ]]; then
        CMD="${CMD} --source-gpus ${SOURCE_GPUS}"
    fi
fi

# Execute
exec ${CMD}

