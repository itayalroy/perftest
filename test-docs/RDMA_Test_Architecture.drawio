                <!-- NVLink reassembly arrows -->
                <mxCell id="aa-reasm-arr" value="NVLink copy: QP k sub-slice (n,m) → reassembly_2d[n×M+m] at offset k×16MB" style="endArrow=classic;html=1;strokeWidth=3;strokeColor=#2E7D32;fontSize=10;fontStyle=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontColor=#000000" parent="1" source="aa-rb0" target="aa-tgt0-0" edge="1">
