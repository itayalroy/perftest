                    <mxGeometry x="332" y="215" width="75" height="45" as="geometry"/>
                </mxCell>

                <!-- 8 NICs -->
                <mxCell id="no-n0" value="NIC mlx5_0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFA07A;strokeColor=#8B3000;fontSize=12;fontStyle=1;strokeWidth=2;fontColor=#000000" parent="1" vertex="1">
                    <mxGeometry x="295" y="300" width="130" height="45" as="geometry"/>
