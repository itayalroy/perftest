                </mxCell>

                <!-- Target GPUs 1-6 condensed -->
                <mxCell id="aa-tgt16" value="Target GPUs 1 – 6   (each: 8 reassembly buffers × 128 MB = 1 GB per target)" style="text;html=1;strokeColor=#aaa;fillColor=#F5F5F5;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=11;fontStyle=2;strokeWidth=1;fontColor=#000000" parent="1" vertex="1">
                    <mxGeometry x="1120" y="588" width="530" height="33" as="geometry"/>
                </mxCell>

                <!-- Target GPU 7 -->
                <mxCell id="aa-tgt7-box" value="Target GPU 7 — 8 buffers × 128 MB = 1 GB total" style="text;html=1;strokeColor=#1B5E20;fillColor=#E8F5E9;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=11;fontStyle=1;strokeWidth=2;fontColor=#000000" parent="1" vertex="1">
