                <mxCell id="aa-rb0" value="&lt;b&gt;QP 0 Buffer — 1 GB&lt;/b&gt;&lt;br&gt;64 slots × 16 MB: [(n=0,m=0)|···|(n=7,m=7)]&lt;br&gt;Thread polls N×M=64 completions, then reassembles" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A78BFA;strokeColor=#3700B3;fontSize=11;strokeWidth=2;align=center;fontColor=#000000" parent="1" vertex="1">
