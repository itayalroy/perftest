                <mxCell id="no-n2" value="NIC mlx5_2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFA07A;strokeColor=#8B3000;fontSize=12;fontStyle=1;strokeWidth=2;fontColor=#000000" parent="1" vertex="1">
                    <mxGeometry x="295" y="420" width="130" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="no-ndots" value="NIC mlx5_3 ··· mlx5_6" style="text;html=1;strokeColor=#aaa;fillColor=#F5F5F5;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=11;fontStyle=2;strokeWidth=1;fontColor=#000000" parent="1" vertex="1">
                    <mxGeometry x="295" y="480" width="130" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="no-n7" value="NIC mlx5_7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFA07A;strokeColor=#8B3000;fontSize=12;fontStyle=1;strokeWidth=2;fontColor=#000000" parent="1" vertex="1">
                    <mxGeometry x="295" y="540" width="130" height="45" as="geometry"/>
                </mxCell>

                <!-- Arrows GPU0 → NICs (all 8 from same source) -->
                <mxCell id="no-a0" value="slice 0" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#007080;fontSize=10;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontColor=#000000" parent="1" source="no-g0" target="no-n0" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="no-a1" value="slice 1" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#007080;fontSize=10;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontColor=#000000" parent="1" source="no-g0" target="no-n1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="no-a2" value="slice 2" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#007080;fontSize=10;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontColor=#000000" parent="1" source="no-g0" target="no-n2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="no-a7" value="slice 7" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#007080;fontSize=10;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontColor=#000000" parent="1" source="no-g0" target="no-n7" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>

                <!-- Key -->
                <mxCell id="no-key" value="&lt;b&gt;Buffer layout (Sender):&lt;/b&gt;&lt;br&gt;• Only GPU 0 is used — 1 GB total, one MR&lt;br&gt;• Buffer logically partitioned: 8 slices × 128 MB&lt;br&gt;• Each NIC DMAs its own slice from GPU 0 memory&lt;br&gt;• GPUs 1-7 are idle&lt;br&gt;&lt;br&gt;&lt;b&gt;Buffer layout (Receiver):&lt;/b&gt;&lt;br&gt;• 8 QP buffers of 128 MB each (on any GPU)&lt;br&gt;• Each QP receives its own 128 MB slice&lt;br&gt;&lt;br&gt;&lt;b&gt;Use case:&lt;/b&gt; Measures peak NIC aggregate BW&lt;br&gt;without NVLink — if BW matches Direct mode,&lt;br&gt;PCIe bandwidth to GPU 0 is the bottleneck." style="text;html=1;strokeColor=#333;fillColor=#FFFDE7;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=12;strokeWidth=2;spacingLeft=10;spacingTop=8;fontColor=#000000" parent="1" vertex="1">
                    <mxGeometry x="30" y="610" width="460" height="185" as="geometry"/>
                </mxCell>

                <!-- Network -->
                <mxCell id="no-net" value="&lt;b&gt;Network&lt;/b&gt;&lt;br&gt;(RDMA fabric)" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#C0C0C0;strokeColor=#333;fontSize=14;fontStyle=1;strokeWidth=2;fontColor=#000000" parent="1" vertex="1">
                    <mxGeometry x="570" y="360" width="220" height="120" as="geometry"/>
                </mxCell>
                <!-- RDMA arrows -->
                <mxCell id="no-r0" value="RDMA" style="endArrow=classic;html=1;strokeWidth=4;strokeColor=#CC0000;fontSize=10;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;entryPerimeter=0;fontColor=#000000" parent="1" source="no-n0" target="no-net" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
