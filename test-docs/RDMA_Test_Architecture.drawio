                <mxCell id="no-n1" value="NIC mlx5_1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFA07A;strokeColor=#8B3000;fontSize=12;fontStyle=1;strokeWidth=2;fontColor=#000000" parent="1" vertex="1">
                    <mxGeometry x="295" y="360" width="130" height="45" as="geometry"/>
