                <mxCell id="aa-ra7" value="" style="endArrow=classic;html=1;strokeWidth=4;strokeColor=#CC0000;exitX=1;exitY=0.9;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontColor=#000000" parent="1" source="aa-net" target="aa-rb7" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>

                <!-- Receiver key -->
                <mxCell id="aa-rcv-key" value="&lt;b&gt;Result after reassembly:&lt;/b&gt;&lt;br&gt;M=8 logical targets, each with N=8 contribution buffers&lt;br&gt;reassembly_2d[n×M+m] on GPU m: contribution from source n to target m&lt;br&gt;= 128 MB, assembled from K=8 QP sub-slices (16 MB each)&lt;br&gt;&lt;br&gt;Total reassembly memory: N×M × 128MB = 64 × 128MB = 8 GB" style="text;html=1;strokeColor=#333;fillColor=#FFFDE7;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=12;strokeWidth=2;spacingLeft=10;spacingTop=8;fontColor=#000000" parent="1" vertex="1">
                    <mxGeometry x="1115" y="730" width="555" height="130" as="geometry"/>
                </mxCell>

                <mxCell id="aa-stats" value="Total data / iteration: 8 × 1 GB = 8 GB    |    Sender threads: N×K×M = 512    |    Receiver threads: K = 8 (each polls N×M=64 completions)" style="text;html=1;strokeColor=#555;fillColor=#E8E8FF;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;fontStyle=1;strokeWidth=2;fontColor=#000000" parent="1" vertex="1">
                    <mxGeometry x="100" y="1020" width="1500" height="40" as="geometry"/>
