                <!-- Key -->
                <mxCell id="d-key" value="&lt;b&gt;Buffer layout (Sender):&lt;/b&gt;&lt;br&gt;• 8 source buffers — one per GPU (GPU-local memory)&lt;br&gt;• Each: 1 GB, registered as RDMA Memory Region (MR)&lt;br&gt;• NIC reads buffer directly via PCIe DMA (GPUDirect)&lt;br&gt;• No NVLink used — each GPU works independently&lt;br&gt;&lt;br&gt;&lt;b&gt;Buffer layout (Receiver):&lt;/b&gt;&lt;br&gt;• 8 QP buffers — one per GPU (GPU-local memory)&lt;br&gt;• Each: 1 GB, registered as RDMA MR (RDMA writes here)&lt;br&gt;• GPU k receives exactly what GPU k on sender sent" style="text;html=1;strokeColor=#333;fillColor=#FFFDE7;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=12;strokeWidth=2;spacingLeft=10;spacingTop=8;fontColor=#000000" parent="1" vertex="1">
                    <mxGeometry x="30" y="540" width="460" height="255" as="geometry"/>
                </mxCell>

