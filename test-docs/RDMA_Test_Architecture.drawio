                <mxCell id="aa-l01" value="src0→tgt1/QP0" style="endArrow=classic;html=1;strokeWidth=1;strokeColor=#0055BB;dashed=1;fontSize=9;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;fontColor=#000000" parent="1" source="aa-sg0" target="aa-qp0" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="aa-l10" value="NVLink: src1→QP0" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#0055BB;dashed=1;fontSize=9;fontStyle=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontColor=#000000" parent="1" source="aa-sg1" target="aa-qp0" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="aa-l77" value="NVLink: src7→QP7" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#0055BB;dashed=1;fontSize=9;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontColor=#000000" parent="1" source="aa-sg7" target="aa-qp7" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>

                <!-- Thread model explanation -->
                <mxCell id="aa-threads" value="&lt;b&gt;Sender thread model:&lt;/b&gt;&lt;br&gt;N×K×M = 8×8×8 = 512 threads total&lt;br&gt;Thread (n, k, m): copies sub-slice for (src=n, target=m) into QP k buf at slot (n×M+m), then RDMA-writes it" style="text;html=1;strokeColor=#0055BB;fillColor=#E3F2FD;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;fontStyle=1;strokeWidth=2;spacingLeft=8;spacingTop=6;fontColor=#000000" parent="1" vertex="1">
                    <mxGeometry x="35" y="470" width="440" height="90" as="geometry"/>
                </mxCell>

                <!-- Sender key -->
                <mxCell id="aa-key" value="&lt;b&gt;Buffer layout (Sender):&lt;/b&gt;&lt;br&gt;• 8 source buffers × 1 GB each = 8 GB total&lt;br&gt;• Source N buffer: M=8 target slices × 128 MB each&lt;br&gt;  Each target slice: K=8 sub-slices × 16 MB (one per QP)&lt;br&gt;• 8 QP buffers × 1 GB each (one per NIC/GPU pair)&lt;br&gt;  QP K buffer: 64 slots (8 sources × 8 targets) × 16 MB&lt;br&gt;• Thread (n,k,m) fills slot (n×M+m) in QP k from source n&lt;br&gt;• qp_mutex serializes RDMA when multiple sources share a QP" style="text;html=1;strokeColor=#333;fillColor=#FFFDE7;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=12;strokeWidth=2;spacingLeft=10;spacingTop=8;fontColor=#000000" parent="1" vertex="1">
                    <mxGeometry x="30" y="590" width="700" height="210" as="geometry"/>
                </mxCell>

                <!-- Network -->
                <mxCell id="aa-net" value="&lt;b&gt;Network&lt;/b&gt;&lt;br&gt;(RDMA fabric)" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#C0C0C0;strokeColor=#333;fontSize=14;fontStyle=1;strokeWidth=2;fontColor=#000000" parent="1" vertex="1">
                    <mxGeometry x="820" y="270" width="210" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="aa-r0" value="RDMA write&#10;(1 GB per QP)" style="endArrow=classic;html=1;strokeWidth=4;strokeColor=#CC0000;fontSize=10;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.1;entryDx=0;entryDy=0;entryPerimeter=0;fontColor=#000000" parent="1" source="aa-qp0" target="aa-net" edge="1">
