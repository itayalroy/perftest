                <mxCell id="aa-tgt0-7" value="reassembly_2d[7×8+0]&#10;src=7, tgt=0: 128MB&#10;[QP0|···|QP7]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A5D6A7;strokeColor=#2E7D32;fontSize=10;strokeWidth=1;align=center;fontColor=#000000" parent="1" vertex="1">
