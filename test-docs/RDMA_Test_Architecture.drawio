                <mxCell id="title" value="Mode 2 — NICs-Only: All NICs stream from a single GPU (GPU 0)" style="text;html=1;strokeColor=#333;fillColor=#FFD700;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=20;fontStyle=1;strokeWidth=2;fontColor=#000000" parent="1" vertex="1">
