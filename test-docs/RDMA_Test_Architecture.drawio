                <mxCell id="aa-tgt0-box" value="Target GPU 0 — 8 buffers × 128 MB = 1 GB total" style="text;html=1;strokeColor=#1B5E20;fillColor=#E8F5E9;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=11;fontStyle=1;strokeWidth=2;fontColor=#000000" parent="1" vertex="1">
